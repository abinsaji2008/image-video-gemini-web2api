# Gemini Web sessions
# Keep these values private. Each cookie should come from the corresponding
# signed-in Gemini Web session and include both __Secure-1PSID and
# __Secure-1PSIDTS when available.

GEMINI_IMAGE_COOKIE=__Secure-1PSID=IMAGE_VALUE; __Secure-1PSIDTS=IMAGE_VALUE
GEMINI_VIDEO_COOKIE=__Secure-1PSID=VIDEO_VALUE; __Secure-1PSIDTS=VIDEO_VALUE

# Optional: legacy/shared session used for chat and model discovery.
# Image/video fall back to these when their dedicated profile is absent.
# GEMINI_COOKIE=__Secure-1PSID=VALUE; __Secure-1PSIDTS=VALUE
# GEMINI_1PSID=VALUE
# GEMINI_1PSIDTS=VALUE

# Optional API protection.
# API_KEYS=my-private-key

# Optional image model override if Google rotates the internal Web model id.
# GEMINI_IMAGE_MODEL_ID=56fdd199312815e2

# Optional generation timeouts.
# GEMINI_IMAGE_MAX_ATTEMPTS=2
# GEMINI_IMAGE_REQUEST_TIMEOUT_SEC=300
# GEMINI_VIDEO_MAX_SECONDS=300
# GEMINI_VIDEO_MAX_ATTEMPTS=2
